POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=job_tracker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

FRONTEND_URL=http://127.0.0.1:5173
SESSION_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://127.0.0.1:8000/auth/linkedin/callback

# Google is the application login. Create an OAuth 2.0 Web client and add the
# callback below as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback
AUTH_REQUIRED=false
AUTH_TOKEN_MAX_AGE_SECONDS=2592000
CLAIM_LEGACY_DATA_ON_FIRST_LOGIN=true
