POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=job_tracker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

FRONTEND_URL=http://127.0.0.1:5173
SESSION_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://127.0.0.1:8000/auth/linkedin/callback

# Google is the application login. Create an OAuth 2.0 Web client and add the
# callback below as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_SHEETS_SYNC_INTERVAL_SECONDS=300
AUTH_REQUIRED=false
# Browser inactivity, rolling cookie lifetime, extension token lifetime, and
# the absolute browser-session ceiling. Values are in seconds.
AUTH_IDLE_TIMEOUT_SECONDS=900
AUTH_TOKEN_MAX_AGE_SECONDS=1800
AUTH_ACCESS_SESSION_SECONDS=1800
AUTH_ABSOLUTE_SESSION_SECONDS=3600
CLAIM_LEGACY_DATA_ON_FIRST_LOGIN=true
