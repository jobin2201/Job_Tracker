{
  "manifest_version": 3,
  "name": "MyStratos",
  "version": "0.13.2",
  "description": "Tracks confirmed job applications across LinkedIn and Indeed.",
  "permissions": ["storage", "identity", "scripting", "webNavigation", "notifications"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://*.indeed.com/*",
    "https://*.indeed.co.in/*",
    "https://job-tracker-backend-n86w.onrender.com/*"
  ],
  "optional_host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/jobs/*"],
      "js": ["linkedin/content.js"],
      "css": ["linkedin/content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.indeed.com/*", "https://*.indeed.co.in/*"],
      "js": ["indeed/content.js"],
      "css": ["indeed/content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "MyStratos",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
